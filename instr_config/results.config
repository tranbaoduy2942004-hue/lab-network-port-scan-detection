_normal = attacker:scan-lab/client.log : FILE_REGEX : NORMAL_CONNECT_OK
_scan = attacker:scan-lab/client.log : FILE_REGEX : PORT_SCAN_COMPLETED count=8
_target1 = target:scan-lab/connections.log : FILE_REGEX : destination_port.*9001
_target8 = target:scan-lab/connections.log : FILE_REGEX : destination_port.*9008
_soc1 = soc:scan-lab/events.log : FILE_REGEX : destination_port.*9001
_soc8 = soc:scan-lab/events.log : FILE_REGEX : destination_port.*9008
_alert = soc:scan-lab/alerts.log : FILE_REGEX : PORT_SCAN_DETECTED
